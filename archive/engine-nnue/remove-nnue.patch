-                     ChessNnueWeights::kOutputLayer1Weight[output_index][hidden_index];
-        }
-        output_layer1[static_cast<std::size_t>(output_index)] = clipped_relu(value);
-    }
-
-    std::array<float, ChessNnueWeights::kOutputLayer2Size> output_layer2{};
-    for (int output_index = 0;
-         output_index < ChessNnueWeights::kOutputLayer2Size;
-         ++output_index) {
-        float value = ChessNnueWeights::kOutputLayer2Bias[output_index];
-        for (int input_index = 0;
-             input_index < ChessNnueWeights::kOutputLayer1Size;
-             ++input_index) {
-            value += output_layer1[static_cast<std::size_t>(input_index)] *
-                     ChessNnueWeights::kOutputLayer2Weight[output_index][input_index];
-        }
-        output_layer2[static_cast<std::size_t>(output_index)] = clipped_relu(value);
-    }
-
-    float score = ChessNnueWeights::kOutputLayer3Bias;
-    for (int input_index = 0;
-         input_index < ChessNnueWeights::kOutputLayer2Size;
-         ++input_index) {
-        score += output_layer2[static_cast<std::size_t>(input_index)] *
-                 ChessNnueWeights::kOutputLayer3Weight[input_index];
-    }
-
-    return static_cast<int>(std::lround(score));
-#else
-    float score = ChessNnueWeights::kFc2Bias;
