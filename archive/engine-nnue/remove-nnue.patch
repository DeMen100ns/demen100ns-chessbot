-            }
-        }
-#endif
-
-        board.nnue_accumulator_valid = true;
-    }
-
-#if CHESS_NNUE_DUAL_PERSPECTIVE
-    const auto clipped_relu = [](float value) {
-        return std::min(1.0F, std::max(0.0F, value));
-    };
-    std::array<float, ChessNnueWeights::kOutputLayer1Size> output_layer1{};
